*.db
*.sqlite
*.sqlite3

# OS and editor artifacts
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json

# Temporary files
*.tmp
*.bak
*.log

# Sample logs under samples/ may be deliberately tracked
!samples/**/*.log
